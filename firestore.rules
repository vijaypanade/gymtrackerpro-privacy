rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Validates RFC-002 sync contract fields on CREATE and UPDATE.
    // Applied exclusively to RFC-002 sync collections (C1 scope boundary).
    function validSyncWrite() {
      let d = request.resource.data;
      return d.schemaVersion is int
          && d.writerDeviceId is string
          && d.writerDeviceId.size() > 0
          && d.updatedAt is timestamp
          && (!('deletedAt' in d) || d.deletedAt is timestamp);
    }

    // RFC-002.3: field-level validation for workout log documents.
    // Applies on CREATE only — updates carry the full snapshot (validSyncWrite covers them).
    function validLogPayload() {
      let d = request.resource.data;
      return d.exercise is string && d.exercise.size() > 0
          && d.date is string
          && d.weight is number
          && d.reps is int;
    }

    // M1: null-safe schemaVersion non-decreasing check.
    // .get('schemaVersion', 0) treats pre-RFC documents (which carry no
    // schemaVersion) as version 0, allowing them to be updated.
    // Must only be called on UPDATE — resource is null on CREATE.
    function validSyncUpdate() {
      return request.resource.data.schemaVersion
          >= resource.data.get('schemaVersion', 0);
    }

    // ── users/{uid} ───────────────────────────────────────────────────────

    match /users/{uid} {

      allow read: if isOwner(uid);

      // C2: Sync contract fields waived for profile root (migration window).
      // TODO(RFC-002.1): Tighten to full base write conditions once
      //   user_provider.dart migrates to the repository pattern.
      // m3: deletedAt must not appear on the profile root document.
      allow create: if isOwner(uid)
          && !('deletedAt' in request.resource.data);
      allow update: if isOwner(uid)
          && !('deletedAt' in request.resource.data);
      allow delete: if false;

      // ── RFC-002 sync collections (C1) ────────────────────────────────

      match /logs/{logId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid) && validSyncWrite() && validLogPayload();
        allow update: if isOwner(uid) && validSyncWrite() && validSyncUpdate();
        allow delete: if false;
      }

      match /plans/{planId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid) && validSyncWrite();
        allow update: if isOwner(uid) && validSyncWrite() && validSyncUpdate();
        allow delete: if false;
      }

      match /instances/{instanceId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid) && validSyncWrite();
        allow update: if isOwner(uid) && validSyncWrite() && validSyncUpdate();
        allow delete: if false;
      }

      match /measurements/{measurementId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid) && validSyncWrite();
        allow update: if isOwner(uid) && validSyncWrite() && validSyncUpdate();
        allow delete: if false;
      }

      match /_meta/{metaId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid) && validSyncWrite();
        allow update: if isOwner(uid) && validSyncWrite() && validSyncUpdate();
        allow delete: if false;
      }

      // ── favorites (m4) ───────────────────────────────────────────────
      // exerciseIds size constraint applied at wildcard level — covers
      // favorites/list, favorites/current, and any novel document IDs.

      match /favorites/{docId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid)
            && (!('exerciseIds' in request.resource.data)
                || request.resource.data.exerciseIds.size() <= 500);
        allow update: if isOwner(uid)
            && (!('exerciseIds' in request.resource.data)
                || request.resource.data.exerciseIds.size() <= 500);
        allow delete: if false;
      }

      // ── history_entries (RFC-002.5) ───────────────────────────────────
      // Append-only session history. One document per completed session,
      // keyed by UUID. Core session fields are immutable after creation;
      // additive metadata fields (e.g. tz_offset, sv bumps) are permitted
      // via the update rule. Client deletion is prohibited — GDPR erasure
      // is handled server-side via Cloud Function on account deletion.

      match /history_entries/{entryId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
            // Document ID must equal the id field for natural deduplication.
            && request.resource.data.id == entryId
            // Required field types.
            && request.resource.data.id is string
            && request.resource.data.date is string
            && request.resource.data.workoutName is string
            && request.resource.data.durationMinutes is int
            && request.resource.data.totalVolume is number
            && request.resource.data.xpEarned is int
            && request.resource.data.sv is int
            // Date must be YYYY-MM-DD (Blocker 2: prevents malformed dates
            // from reaching streak computation on restore).
            && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');

        // Additive metadata only. Core session fields (id, date,
        // totalVolume, xpEarned, workoutName, durationMinutes) are
        // immutable. New metadata fields (e.g. tz_offset added in
        // RFC-002.10) are permitted because they are not in this list.
        allow update: if isOwner(uid)
            && request.resource.data.id == resource.data.id
            && request.resource.data.date == resource.data.date
            && request.resource.data.totalVolume == resource.data.totalVolume
            && request.resource.data.xpEarned == resource.data.xpEarned
            && request.resource.data.workoutName == resource.data.workoutName
            && request.resource.data.durationMinutes == resource.data.durationMinutes;

        allow delete: if false;
      }
    }

    // ── Legacy paths — no sync fields required (§2.6) ────────────────────

    match /workout_history/{uid} {
      allow read:   if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;
    }

    // RFC-002.3: premium_grants is server-owned. Cloud Functions (Admin SDK)
    // bypass these rules and can still write. No client write path is permitted —
    // any authenticated user who could write here could self-grant premium.
    match /premium_grants/{uid} {
      allow read:                    if isOwner(uid);
      allow create, update, delete:  if false;
    }

    // ── Server-owned collections — GET own UID only, no client writes (m1) ─

    match /entitlements/{uid} {
      allow get: if isOwner(uid);
    }

    match /ai_usage/{uid} {
      allow get: if isOwner(uid);
    }

  }
}
